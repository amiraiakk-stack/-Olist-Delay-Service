# Copy this file to .env and fill in real values. .env is gitignored - never commit secrets.

# MLflow's Postgres backend store (docker-compose.yml).
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me

# The live Olist database scripts/train_pipeline.py reads from. Required for real training;
# not needed to just run `docker compose up --build` (that uses a synthetic fixture model).
DB_USER=
DB_PASS=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432
